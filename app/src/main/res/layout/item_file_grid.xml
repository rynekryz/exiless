<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/grid_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:clipToOutline="true">

    <com.rynekryz.exiless.ui.SquareImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/grid_status_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/badge_gps"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/grid_badge_bg"
        android:contentDescription="@string/status_gps"
        android:padding="4dp"
        android:src="@drawable/ic_oui_location"
        app:tint="#FFFFFFFF" />

    <ImageView
        android:id="@+id/badge_done"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="@drawable/grid_badge_bg"
        android:contentDescription="@string/status_cleaned"
        android:padding="4dp"
        android:src="@drawable/ic_oui_checkbox_checked"
        app:tint="#FFFFFFFF" />
</FrameLayout>
